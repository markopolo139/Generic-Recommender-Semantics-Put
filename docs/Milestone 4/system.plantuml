@startuml
skinparam backgroundColor white
skinparam activity {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #333333
}

start

:Initialize Generic Recommender System;

partition "Data Ingestion & Preprocessing" {
    :Ingest Source Datasets
    Input can be any domain.;

    :Define Entity Mappings
    (Map Raw Columns -> Users, Items, Features);
    
    :Preprocessing & Merge
    Normalizes ratings and processes
    implicit/explicit feedback types;
}

partition "Graph Construction" {
    :Receive Normalized Data;
    
    :Construct Heterogeneous Graph
    Creates edges between User, Item,
    and Feature nodes;
}

partition "Model Training & Execution" {
    switch ( Select Model Strategy )
    case (  )
        :Matrix Factorization;
    case (  )
        :NCF;
    case (  )
        :LightGCN;
    case (  )
        :Node2Vec;
    case (  )
        :Cleora;
    endswitch
    :Train Selected Model;
    if (Ground Truth Available?) then (Yes)
    :Run Evaluation Metrics;
    else (No / Skip)
    endif
}

:Generate Top-N Recommendations;


stop
@enduml
